{
  "name": "spar-dynamics-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive SPAR floating offshore wind turbine simulation with a rotary tuned mass damper",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
